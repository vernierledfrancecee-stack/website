generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
}

enum StatutDossier {
  EN_COURS
  DOSSIER_CONSTITUE
  DEPOSE
  EN_CONTROLE
  VALIDE
  CERTIFIE
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  emailEncrypted   String?
  password         String
  role             Role        @default(CLIENT)
  name             String?
  company          String?
  phoneEncrypted   String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean     @default(false)
  recoveryCodes    String[]
  passwordHistory  String[]
  loginAttempts    Int         @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  dossiers         Dossier[]
  auditLogs        AuditLog[]
}

model Dossier {
  id           String        @id @default(cuid())
  reference    String        @unique
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  ficheCode    String
  siteAdresse  String
  surface      Float?
  secteur      String?
  statut       StatutDossier @default(EN_COURS)
  mondayItemId String?
  lastSyncAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  documents    Document[]
  notes        Note[]
}

model Document {
  id         String   @id @default(cuid())
  dossierId  String
  dossier    Dossier  @relation(fields: [dossierId], references: [id])
  nom        String
  type       String
  url        String
  storageKey String?
  createdAt  DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id])
  contenu   String
  auteur    String
  createdAt DateTime @default(now())
}

model Lead {
  id             String    @id @default(cuid())
  nom            String
  prenom         String
  email          String
  telephone      String?
  societe        String?
  fonction       String?
  siteAdresse    String?
  secteur        String
  energie        String?
  surface        Float?
  zone           String?
  eclairage      String?
  fichesCibles   String[]
  donneesBrutes  Json
  statut         String    @default("NOUVEAU")
  mondayItemId   String?
  consentement   Boolean   @default(false)
  consentementAt DateTime?
  createdAt      DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  ressource String?
  ipAddress String
  userAgent String
  details   Json?
  createdAt DateTime @default(now())
}

model ConsentLog {
  id        String   @id @default(cuid())
  email     String
  type      String
  consentAt DateTime @default(now())
  ipAddress String
}

model ContactMessage {
  id        String   @id @default(cuid())
  nom       String
  prenom    String
  email     String
  telephone String?
  societe   String?
  secteur   String?
  message   String
  createdAt DateTime @default(now())
}

model WaitlistRenovGlobale {
  id        String   @id @default(cuid())
  nom       String
  email     String
  societe   String?
  surface   Float?
  telephone String?
  message   String?
  source    String   @default("SIMULATEUR")
  notifie   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RapportBTH174 {
  id              String   @id @default(cuid())
  reference       String   @unique
  // Snapshot du formulaire complet
  donneesJson     Json
  // Résultats calculés
  eligible        Boolean
  scenarios       String[]
  niveauPrecarite String
  sauts           Int      @default(0)
  // Méta
  nomBeneficiaire String
  adresse         String?
  operateur       String?
  createdAt       DateTime @default(now())
}
