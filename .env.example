# Base de données PostgreSQL (sslmode=require en production)
DATABASE_URL=postgresql://user:password@host:5432/ledx_energie?sslmode=require

# NextAuth.js — générer avec: openssl rand -base64 64
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Chiffrement données sensibles — générer avec: openssl rand -hex 32
ENCRYPTION_KEY=

# Brevo (ex Sendinblue) — Email transactionnel
BREVO_API_KEY=
BREVO_FROM_EMAIL=contact@ledxenergie.com

# Monday.com API
MONDAY_API_KEY=
MONDAY_BOARD_LEADS=
MONDAY_BOARD_DOSSIERS=
MONDAY_WEBHOOK_SECRET=

# Yousign API (signatures électroniques)
YOUSIGN_API_KEY=

# hCaptcha (protection formulaires)
HCAPTCHA_SECRET_KEY=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://ledxenergie.com

# Monday.com — URL d'embed iframe pour /simulateur-interne (formulaire ou vue CRM)
# Exemple : https://forms.monday.com/forms/embed/XXXX
NEXT_PUBLIC_MONDAY_EMBED_URL=
